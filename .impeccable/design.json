      "css": ".ds-text{font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Hiragino Sans GB\",sans-serif;line-height:1.5;font-size:1rem;border:0;background:transparent;color:var(--green,#4d654f);text-decoration:underline;text-underline-offset:5px;min-height:44px;padding:8px 0;cursor:pointer}.ds-text:disabled{color:var(--secondary,#687266);text-decoration:none;cursor:default}.ds-text:focus-visible{outline:2px solid var(--green,#4d654f);outline-offset:3px}"
    },
    {
