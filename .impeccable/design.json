      "css": ".ds-primary{font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Hiragino Sans GB\",sans-serif;line-height:1.5;width:100%;min-height:56px;border:0;border-radius:28px;background:var(--green,#4d654f);color:#fff;display:flex;align-items:center;justify-content:center;gap:12px;font-weight:600;font-size:1rem;padding:12px 20px;cursor:pointer;transition:background-color .16s ease-out}.ds-primary:hover{background:#3e5741}.ds-primary:active{background:#354b38}.ds-primary:disabled{background:#dce2d5;color:var(--secondary,#687266);cursor:default}.ds-primary:focus-visible{outline:2px solid var(--green,#4d654f);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
