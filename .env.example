# Copy to repository root .env for local server setup. Fake local values only.
NODE_ENV=development
PORT=3100
DATABASE_URL=postgresql://replace_me:replace_me@localhost:5432/wanpet
CLIENT_ORIGIN=http://localhost:5173
# No live credentials belong in this repository.
ALIYUN_ECS_IP_HOST=server.example.invalid
ALIYUN_ECS_HOST_PASSWORD=replace-with-private-value

HOST=127.0.0.1

# Jev is called only by the server. Leave empty to use local cat behavior.
TOKEN_HUB_API_KEY=
# Optional with a configured key; defaults shown below.
# TOKEN_HUB_API_BASE_URL=https://us-api.tokenhub.com/v1
# PET_LIFE_MODEL=jev-1.14
# PET_LIFE_DAILY_CALLS=240

# Pet conversation; TOKEN_HUB_WEB_URL is documentation, not an API endpoint.
PET_CHAT_ENABLED=false
# PET_CHAT_MODEL=claude-haiku-5.5
# PET_CHAT_DAILY_TURNS=100
# Use a separate database with pgvector installed. Credentials are local only.
# MEM0_DATABASE_URL=postgresql://wanpet_memory:replace-with-private-value@127.0.0.1:54329/wanpet_memory
# HUOSHAN_API_KEY=replace-with-private-value
# ASR may be configured later; text chat does not depend on it.
ASR_API_KEY=
# ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ASR_MODEL=qwen3-asr-flash
# Image uploads use a private persistent directory. Back it up together with PostgreSQL.
# PET_MEDIA_DIR=.data/pet-images
# Seedream is optional; configure a verified model ID and per-image CNY price (fen).
SEEDREAM_API_KEY=
# SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# SEEDREAM_MODEL=doubao-seedream-5-0-flash-260915
# SEEDREAM_UNIT_PRICE_FEN=12
# IMAGE_DAILY_BUDGET_FEN=1000
# PET_IMAGE_REFERENCE_PATH=assets/characters/calico/calico-character-reference-v1.png
