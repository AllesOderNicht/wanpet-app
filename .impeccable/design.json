      "html": "<div class=\"ds-room\" aria-label=\"切换场景\"><button type=\"button\" aria-pressed=\"true\">小屋</button><button type=\"button\" aria-pressed=\"false\">庭院</button></div>",
      "css": ".ds-room{font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Hiragino Sans GB\",sans-serif;line-height:1.5;display:inline-flex;gap:2px;padding:2px;border-radius:24px;background:#fbfaf5eb}.ds-room button{font:inherit;min-height:44px;padding:8px 16px;border:0;border-radius:22px;background:transparent;color:var(--secondary,#687266);font-size:.875rem;cursor:pointer}.ds-room button[aria-pressed=true]{background:var(--wash,#e7ecdd);color:var(--green,#4d654f);font-weight:600}.ds-room button:focus-visible{outline:2px solid var(--green,#4d654f);outline-offset:3px}"
    },
    {
      "name": "宠物状态",
      "kind": "chip",
      "refersTo": "status-chip",
      "description": "状态文字与分隔点；面板省略运行时的水彩位图，不替换为字符图标。",
      "html": "<p class=\"ds-status\">在家<span class=\"ds-dot\" aria-hidden=\"true\"></span>自在休息</p>",
      "css": ".ds-status{font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Hiragino Sans GB\",sans-serif;line-height:1.5;display:inline-flex;align-items:center;gap:7px;background:var(--wash,#e7ecdd);color:var(--green,#4d654f);padding:5px 14px;border-radius:24px;font-size:.875rem;margin:0}.ds-dot{width:3px;height:3px;background:currentColor;border-radius:50%;margin:0 2px}"
    },
    {
      "name": "物品格",
      "kind": "card",
      "refersTo": "inventory-tile",
      "description": "选中框、勾号与真实标签；面板只展示控件层，运行时物品美术仍由资源表提供。",
      "html": "<div class=\"ds-inventory\"><button class=\"ds-item ds-selected\" type=\"button\" aria-pressed=\"true\" aria-label=\"便当，拥有3，已选择\"><span class=\"ds-selected-mark\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg></span><span>便当</span><small>×3</small></button><button class=\"ds-item\" type=\"button\" aria-pressed=\"false\" aria-label=\"水壶，拥有2\"><span>水壶</span><small>×2</small></button><button class=\"ds-item\" type=\"button\" disabled aria-pressed=\"false\" aria-label=\"毛巾，拥有0\"><span>毛巾</span><small>数量不足</small></button></div>",
      "css": ".ds-inventory{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.ds-item{font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Hiragino Sans GB\",sans-serif;line-height:1.5;color:var(--ink,#3f4a40);position:relative;min-height:136px;border:1px solid #dce2d5;border-radius:16px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;padding:10px 5px;background:#fffdf8;font-size:.875rem;cursor:pointer}.ds-item small{font-size:.875rem;color:var(--secondary,#687266);font-variant-numeric:tabular-nums}.ds-item.ds-selected{border:2px solid var(--green,#4d654f);padding:9px 4px;background:#f1f4ea}.ds-item:disabled:not(.ds-selected){background:#eeeee8;cursor:default}.ds-selected-mark{position:absolute;top:7px;right:7px;width:22px;height:22px;border-radius:50%;background:var(--green,#4d654f);color:#fff;padding:3px}.ds-selected-mark svg{display:block;width:16px;height:16px}.ds-item:focus-visible{outline:2px solid var(--green,#4d654f);outline-offset:3px}@media(max-width:350px){.ds-item{min-height:124px}}@media(max-width:350px){.ds-inventory{gap:8px}}"
    },
    {
      "name": "底部导航",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "文字、状态与安全区原语；面板省略水彩图标，正式导航仍使用可见范围裁定的实际美术。",
      "html": "<nav class=\"ds-nav\" aria-label=\"主要导航\"><button type=\"button\" aria-current=\"page\">家园</button><button type=\"button\">旅途</button><button type=\"button\">收藏</button></nav>",
      "css": ".ds-nav{font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Hiragino Sans GB\",sans-serif;line-height:1.5;display:flex;min-height:calc(76px + env(safe-area-inset-bottom));padding:5px 16px max(5px,env(safe-area-inset-bottom));background:#fff}.ds-nav button{font:inherit;border:0;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;min-height:66px;background:transparent;color:var(--secondary,#687266);position:relative;font-size:.875rem;cursor:pointer}.ds-nav button[aria-current]{color:var(--green,#4d654f);font-weight:600}.ds-nav button[aria-current]:after{content:\"\";position:absolute;bottom:0;width:26px;height:3px;border-radius:2px;background:var(--green,#4d654f)}.ds-nav button:hover{background:#fbfaf5;border-radius:12px}.ds-nav button:focus-visible{outline:2px solid var(--green,#4d654f);outline-offset:3px}"
    },
    {
      "name": "自动散步开关",
      "kind": "input",
      "refersTo": "walk-toggle",
      "description": "原生复选框与可点击标签；减少动态效果时由应用禁用。",
      "html": "<label class=\"ds-walk\"><input type=\"checkbox\" checked/><span>自动散步</span></label>",
      "css": ".ds-walk{font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Hiragino Sans GB\",sans-serif;line-height:1.5;display:inline-flex;align-items:center;gap:9px;min-height:44px;color:var(--secondary,#687266);font-size:.875rem;cursor:pointer}.ds-walk input{width:18px;height:18px;margin:0;accent-color:var(--green,#4d654f);caret-color:var(--green,#4d654f);touch-action:manipulation}.ds-walk input:focus-visible{outline:2px solid var(--green,#4d654f);outline-offset:3px}"
    }
  ],
  "narrative": {
    "northStar": "窗边小屋里的水彩陪伴",
    "overview": "沿用已选定的清透日系绘本方向：暖白承托真实文字，鼠尾草绿承托操作，水彩材质属于场景、宠物和物品。界面像安静的绘本页，控件保持清晰、实色和可操作，不把整张设计稿当作界面。\n\n这是对当前 React / PixiJS 网页实现的提取。原创三花猫是现有资源包，宠物活动层独立于静态场景；后续物种通过各自的动作、可见范围和锚点接入，不继承猫的身体结构。本文不把未实装的旅行、账号保存或在线 AI 生成为视觉状态。",
    "keyCharacteristics": [
      "暖白阅读面与克制的鼠尾草操作色。",
      "水彩插画和独立文本、原生可访问控件并存。",
      "单列移动容器、可滚动内容与不缩小的操作热区。",
      "宠物以独立动作帧移动；减少动态效果时仍可直接定位。"
    ],
    "rules": [
      {
        "name": "The Painted World, Clear Controls Rule",
        "body": "水彩的色彩、纹理和明暗留在美术中；正文阅读面和主操作保持干净、实色。不要给整屏再罩米黄滤镜。",
        "section": "colors"
      },
      {
        "name": "The Live Text Rule",
        "body": "名称、状态、数量、导航和错误必须是实际文本；图片里的字形不成为字体规则。系统中文字体栈是已交接并已实现的选择。",
        "section": "typography"
      },
      {
        "name": "The Quiet Depth Rule",
        "body": "控件靠色面、描边、留白和选中标记建立层级；外壳的柔和投影不扩散成每个物品格的阴影。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 保持暖白阅读面、鼠尾草实色操作和插画自身的水彩材质。",
      "Do 使用真实文字、可访问名称、键盘焦点以及至少 44px 的操作热区。",
      "Do 用描边、勾号或下划线补充颜色状态，并保留“数量不足”等明确文字。",
      "Do 让小屏和长内容滚动；按资源包的全部帧、可见范围和锚点适配宠物。",
      "Do 跟随系统减少动态效果，保留文本反馈与即时定位。",
      "Do 在演示数据和未接入能力旁保留清楚的预览或未开放说明。"
    ],
    "donts": [
      "Don't 把整张画面截图当作交互层，或让插画降低正文和操作的可读性。",
      "Don't 为适配短屏缩小文字、物品标签或操作热区。",
      "Don't 用强阴影、装饰性卡片堆叠或满屏滤镜覆盖现有的轻盈层级。",
      "Don't 用单张立绘平移替代步行动作，或把猫的骨骼、翻转复用当作通用宠物规则。",
      "Don't 在本地搭配成功时伪装成账号已保存、道具已消耗或真实旅行已开始。"
    ]
  }
}
