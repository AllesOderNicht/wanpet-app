      "html": "<button class=\"ds-icon\" type=\"button\" aria-label=\"返回家园\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M19 12H5m7-7-7 7 7 7\"/></svg></button>",
      "css": ".ds-icon{font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Hiragino Sans GB\",sans-serif;line-height:1.5;color:var(--ink,#3f4a40);border:0;display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;padding:10px;background:transparent;border-radius:50%;cursor:pointer}.ds-icon svg{width:26px;height:26px;flex-shrink:0}.ds-icon:hover{background:#e7ecddc9}.ds-icon:focus-visible{outline:2px solid var(--green,#4d654f);outline-offset:3px}"
    },
