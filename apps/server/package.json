{
  "name": "@wanpet/server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run build && node --env-file=../../.env --import tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "test:compile": "tsc -p tsconfig.test.json",
    "test": "npm run test:compile && node --test .test-dist/test/unit.test.js .test-dist/test/cat-life.test.js .test-dist/test/pet-profile.test.js .test-dist/test/pet-life-v2.test.js .test-dist/test/chat.test.js .test-dist/test/images.test.js",
    "test:integration": "npm run test:compile && node --test --test-concurrency=1 .test-dist/test/integration.test.js .test-dist/test/travel.integration.test.js .test-dist/test/cat-life.integration.test.js .test-dist/test/pet-care.integration.test.js .test-dist/test/chat.integration.test.js .test-dist/test/images.integration.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@openai/codex-sdk": "0.164.0",
    "@prisma/client": "^6.0.0",
    "@wanpet/contracts": "*",
    "mem0ai": "3.3.1",
    "ollama": "0.5.18",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0"
  }
}
